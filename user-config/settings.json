{
  "enableAllProjectMcpServers": false,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "/users",
        "~/.claude/.credentials.json",
        "~/.claude/history.jsonl",
        "~/.claude/stats-cache.json",
        "~/.claude/sessions",
        "~/.claude/session-env",
        "~/.claude/shell-snapshots",
        "~/.claude/paste-cache",
        "~/.claude/file-history",
        "~/.claude/.cc-writes",
        "~/.claude/backups",
        "~/.claude/downloads",
        "~/.claude/hfi-auth.json",
        "~/.claude/daemon-auth-status.json",
        "~/.claude/daemon.json",
        "~/.claude/daemon.log",
        "~/.claude/telemetry",
        "~/.claude/daemon",
        "~/.claude/plugins",
        "~/.claude/tasks"
      ],
      "allowRead": [
        "./",
        "~/.local"
      ],
      "denyWrite": [
        ".claude/settings.json",
        ".claude/settings.local.json",
        ".Rprofile",
        ".Renviron",
        ".hg/hgrc"
      ],
      "allowWrite": []
    },
    "network": {
      "allowedDomains": [
        "opendatadocs.meteoswiss.ch:443"
      ],
      "strictAllowlist": true
    }
  },
  "permissions": {
    "allow": [
      "Bash(sinfo *)",
      "Bash(squeue *)",
      "Bash(sacct *)",
      "Bash(scontrol show *)",
      "Bash(sprio *)",
      "Bash(sreport *)"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "EndConversation",
      "Artifact",
      "Read",
      "Write",
      "Edit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "EnterWorktree",
      "ExitWorktree",
      "PushNotification",
      "RemoteTrigger",
      "SendMessage",
      "ListAgents",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "DesignSync",
      "LSP",
      "Monitor",
      "ReportFindings",
      "Workflow",
      "TaskOutput",
      "ToolSearch",
      "Edit(~/.claude/settings.json)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(~/.local/lib/husk/**)",
      "Read(//**/.env*)",
      "Edit(//**/.env*)",
      "Read(//**/*.env)",
      "Edit(//**/*.env)",
      "Read(//**/*.pem)",
      "Edit(//**/*.pem)",
      "Read(//**/*.key)",
      "Edit(//**/*.key)",
      "Read(//**/*.cer)",
      "Edit(//**/*.cer)",
      "Read(//**/*.crt)",
      "Edit(//**/*.crt)",
      "Read(//**/*.p12)",
      "Edit(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Edit(//**/*.pfx)",
      "Read(//**/*.jks)",
      "Edit(//**/*.jks)",
      "Read(//**/credentials)",
      "Edit(//**/credentials)",
      "Read(//**/.netrc)",
      "Edit(//**/.netrc)",
      "Read(//**/.git-credentials)",
      "Edit(//**/.git-credentials)",
      "Read(//**/.npmrc)",
      "Edit(//**/.npmrc)",
      "Read(//**/.pypirc)",
      "Edit(//**/.pypirc)",
      "Read(//**/.docker/config.json)",
      "Edit(//**/.docker/config.json)",
      "Read(//**/.ssh/**)",
      "Edit(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Edit(//**/.aws/**)",
      "Read(//**/.kube/**)",
      "Edit(//**/.kube/**)",
      "Read(//**/.config/gcloud/**)",
      "Edit(//**/.config/gcloud/**)",
      "Read(//**/.gnupg/**)",
      "Edit(//**/.gnupg/**)",
      "Bash(nc *)",
      "Bash(socat *)"
    ]
  }
}
